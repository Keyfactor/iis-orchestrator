#
# Keyfactor.WinCert.LDAP.psrc
# JEA Role Capability file for Keyfactor Windows Certificate Store (AD DS / NTDS LDAPS operations)
#
# INSTALL LOCATION:
#   This file must live inside the module folder that PowerShell can discover:
#     C:\Program Files\WindowsPowerShell\Modules\
#       Keyfactor.WinCert.LDAP\
#         RoleCapabilities\
#           Keyfactor.WinCert.LDAP.psrc   <-- this file
#
#   PowerShell finds the role capability by name ('Keyfactor.WinCert.LDAP') by searching
#   all modules in $env:PSModulePath for a RoleCapabilities subfolder with a matching .psrc.
#
# LANGUAGE MODE NOTE:
#   The session configuration (KeyfactorWinCert.pssc) sets LanguageMode = 'ConstrainedLanguage'.
#   Module code loaded from a trusted path ($env:PSModulePath) runs as FULLY TRUSTED and can
#   use .NET APIs freely. The ConstrainedLanguage restriction only applies to caller scriptblocks
#   sent by the orchestrator (e.g., param() blocks for parameter passing).
#
# DOUBLE-HOP NOTE (see docsource/winldap.md):
#   Every VisibleFunctions entry below does all of its work using only local resources on the
#   target Domain Controller (local registry, local X.509 APIs, local $env: variables). None of
#   them call Active Directory-module cmdlets or anything else that would require this JEA
#   session's identity to authenticate outward to a second machine. This is a hard design
#   requirement, not an incidental property - see Test-LdapsCertificateEligibility.ps1 for the most
#   safety-critical instance of this rule.
#
# PERMISSIONS NOTE (UNVERIFIED - see docsource/winldap.md and docs/winldap-implementation-notes.md):
#   It has not been confirmed whether a JEA virtual account (or gMSA) with local-Administrator-
#   equivalent rights is sufficient to write to
#   HKLM\SOFTWARE\Microsoft\Cryptography\Services\NTDS\SystemCertificates. This must be validated on
#   a lab Domain Controller before this JEA configuration is relied upon in production - run
#   Get-KeyfactorDiagnostics and a full Add/Remove round-trip through the JEA session first.
#
@{
    GUID        = '22b59d48-ce9e-40e7-b9ea-23f4b396fcbc'
    Author      = 'Keyfactor'
    Description = 'Role capabilities for Keyfactor Windows Certificate Store AD DS (NTDS) LDAPS operations (inventory, add, remove)'

    # Import both modules so their functions are pre-loaded and run as trusted code.
    # Both modules MUST be installed under C:\Program Files\WindowsPowerShell\Modules\ so that
    # PowerShell treats them as trusted (required for .NET API usage in ConstrainedLanguage sessions).
    ModulesToImport = @('Keyfactor.WinCert.Common', 'Keyfactor.WinCert.LDAP')

    # Functions the orchestrator is allowed to invoke in this JEA session.
    # Test-KeyfactorAdminRights is included for potential future use when admin checks are required.
    VisibleFunctions = @(
        'Get-KeyfactorLdapCertificates',
        'Add-KeyfactorLdapsCertificate',
        'Remove-KeyfactorLdapsCertificate',
        'Test-KeyfactorAdminRights'
    )

    # Cmdlets available to caller scriptblocks (param() wrappers sent by PSHelper).
    # Module functions are trusted and can use any cmdlet internally regardless of this list.
    VisibleCmdlets = @(
        'ConvertTo-Json',
        'ConvertFrom-Json',
        'Write-Output',
        'Write-Verbose',
        'Write-Warning',
        'Write-Error',
        'Write-Information'
    )

    # No external commands needed - the NTDS service store is read/written/deleted directly via
    # the registry and System.Security.Cryptography.X509Certificates.X509Certificate2, not
    # certutil.exe or any other external process.
    VisibleExternalCommands = @()

    # No variables need to be pre-defined for the orchestrator.
    VisibleVariables = @()

    # No aliases beyond what the module exports.
    VisibleAliases = @()
}
